{
  "schemaVersion": 1,
  "id": "canvasmenu",
  "version": "${version}",
  "name": "Canvas Menu",
  "description": "Canvas-style client UI for Minecraft 1.21.11 (Fabric, Java 21): a card-based inventory plus a built-in icon Command Center with JSON-driven commands, async textures and GitHub Release auto-update.",
  "authors": [
    "ChaosSurvivalProject"
  ],
  "contact": {
    "homepage": "https://github.com/ChaosSurvivalProject/CanvasMenu",
    "issues": "https://github.com/ChaosSurvivalProject/CanvasMenu/issues",
    "sources": "https://github.com/ChaosSurvivalProject/CanvasMenu"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.chaossurvival.canvasmenu.CanvasMenu",
      "com.canvasmenu.CommandCenter"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": "~1.21.11",
    "fabric-api": "*",
    "java": ">=21"
  },
  "custom": {
    "canvasmenu": {
      "updateOwner": "ChaosSurvivalProject",
      "updateRepo": "CanvasMenu",
      "updateUrl": "https://api.github.com/repos/ChaosSurvivalProject/CanvasMenu/releases/latest",
      "commandConfig": "assets/canvasmenu/commands.json",
      "commandOverride": "config/canvasmenu-commands.json",
      "textures": "assets/canvasmenu/textures/commands/",
      "stagingDir": "mods/.canvasmenu-update/",
      "lockFile": "mods/update.lock"
    }
  }
}
